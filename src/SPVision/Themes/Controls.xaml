    <StreamGeometry x:Key="IconChevronLeft">M15,18 L9,12 L15,6</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconClock">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M12,7 V12 L15,14</StreamGeometry>
