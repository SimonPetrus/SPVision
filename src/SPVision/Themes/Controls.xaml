    <StreamGeometry x:Key="IconLock">M5,11 H19 A2,2 0 0 1 21,13 V20 A2,2 0 0 1 19,22 H5 A2,2 0 0 1 3,20 V13 A2,2 0 0 1 5,11 Z M7,11 V7 A5,5 0 0 1 17,7 V11</StreamGeometry>
    <!-- Motion box: dashed rectangle (corners + side dashes) around a small filled target. -->
    <StreamGeometry x:Key="IconMotion">M3,7 V5 A2,2 0 0 1 5,3 H7 M10.5,3 H13.5 M17,3 H19 A2,2 0 0 1 21,5 V7 M21,10.5 V13.5 M21,17 V19 A2,2 0 0 1 19,21 H17 M13.5,21 H10.5 M7,21 H5 A2,2 0 0 1 3,19 V17 M3,13.5 V10.5</StreamGeometry>
