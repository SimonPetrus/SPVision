<!--
    SPVision shared styles: fonts, icon geometries and control styles for both themes.
    Every colour comes from the active theme dictionary (Themes/Light.xaml or Themes/Dark.xaml) through
    DynamicResource, so switching the theme at run time restyles everything. No raw hex values here or in views.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Nearly transparent: keeps an area hit-testable without drawing anything visible. -->
    <SolidColorBrush x:Key="HitTestBg" Color="#01000000" />

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="FontSizeBadge">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeStatus">11.5</sys:Double>
    <sys:Double x:Key="FontSizeTile">12</sys:Double>
    <sys:Double x:Key="FontSizeList">12.5</sys:Double>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeBrand">15</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">13.5</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>

    <!-- ===== Icons (24×24 stroke geometry, drawn by Controls/GlyphIcon) ===== -->
