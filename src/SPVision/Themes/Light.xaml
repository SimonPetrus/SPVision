<!--
    SPVision light theme (Windows 11 palette): colours and brushes only. Themes/Light.xaml and
    Themes/Dark.xaml define exactly the same keys; ThemeManager swaps one for the other at run time, so views
    must reference these brushes with DynamicResource. Styles, fonts and icons live in Themes/Controls.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Colours ===== -->
    <Color x:Key="WindowColor">#F3F3F3</Color> <!-- window background -->
    <Color x:Key="BarColor">#FAFAFA</Color> <!-- top bar, status bar, sidebars -->
    <Color x:Key="CardColor">#FFFFFF</Color> <!-- settings cards, tool tips, menus -->
    <Color x:Key="SubtleColor">#F9F9F9</Color> <!-- table header rows -->
    <Color x:Key="DeviceRowColor">#F3F3F3</Color> <!-- device row of the live sidebar -->
    <Color x:Key="InputColor">#FFFFFF</Color> <!-- text boxes -->
    <Color x:Key="GutterColor">#202020</Color> <!-- camera wall gutter: dark in both themes -->
    <Color x:Key="TileColor">#000000</Color> <!-- tile frame behind the video -->
    <Color x:Key="TileHeaderColor">#F9F9F9</Color> <!-- tile header strip -->
    <Color x:Key="VideoColor">#000000</Color> <!-- video area -->
    <Color x:Key="BorderColor">#E5E5E5</Color> <!-- borders -->
    <Color x:Key="DividerColor">#EBEBEB</Color> <!-- row separators inside cards -->
    <Color x:Key="InputBorderColor">#D1D1D1</Color> <!-- input / button borders -->
    <Color x:Key="BadgeBorderColor">#D1D1D1</Color> <!-- HD/SD badge -->
    <Color x:Key="TileBorderColor">#E5E5E5</Color> <!-- tile frame -->
    <Color x:Key="TextStrongColor">#1A1A1A</Color> <!-- headings, input text -->
    <Color x:Key="TextColor">#1A1A1A</Color> <!-- text -->
    <Color x:Key="IconColor">#1A1A1A</Color> <!-- icons -->
    <Color x:Key="TextSecondaryColor">#5C5C5C</Color> <!-- secondary text -->
    <Color x:Key="OfflineColor">#8A8A8A</Color> <!-- offline dot -->
    <Color x:Key="HoverColor">#EBEBEB</Color> <!-- hover; dark = 6 % white, i.e. #2D2D2D on the window and still visible on cards -->
    <Color x:Key="PressedColor">#E0E0E0</Color> <!-- pressed -->
    <Color x:Key="ListSelectedColor">#E0E0E0</Color> <!-- selected list row (with accent bar) -->
    <Color x:Key="SelectedColor">#0067C0</Color> <!-- selected segment / nav item / pressed icon toggle -->
    <Color x:Key="SelectedTextColor">#FFFFFF</Color> <!-- text on SelectedBg -->
    <Color x:Key="AccentColor">#0067C0</Color> <!-- wordmark, tab underline, focus, primary button -->
    <Color x:Key="AccentHoverColor">#1975C5</Color> <!-- primary button hover -->
    <Color x:Key="OnAccentColor">#FFFFFF</Color> <!-- text on Accent -->
    <Color x:Key="OnlineColor">#0F7B0F</Color> <!-- online / ok -->
    <Color x:Key="RecordedColor">#0F7B0F</Color> <!-- recorded segments on the timeline -->
    <Color x:Key="WarningColor">#9D5D00</Color> <!-- connecting / caution dot -->
    <Color x:Key="WarningTextColor">#9D5D00</Color> <!-- connecting / caution text -->
    <Color x:Key="DangerColor">#C42B1C</Color> <!-- recording badge, failed dot -->
    <Color x:Key="DangerIconColor">#C42B1C</Color> <!-- record icon -->
    <Color x:Key="DangerTextColor">#C42B1C</Color> <!-- destructive button text and border -->
    <Color x:Key="SwitchOffColor">#8A8A8A</Color> <!-- toggle switch track when off -->
    <Color x:Key="SwitchKnobColor">#FFFFFF</Color> <!-- toggle switch knob when off -->
    <Color x:Key="WallTextColor">#A0A0A0</Color> <!-- text on the (always dark) camera wall -->
    <Color x:Key="WallLineColor">#454545</Color> <!-- empty tile outline on the camera wall -->
    <Color x:Key="ScrimColor">#99000000</Color> <!-- scrim over video -->
    <Color x:Key="FlashColor">#0067C0</Color> <!-- snapshot flash of the tile header -->

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="BarBg" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="CardBg" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SubtleBg" Color="{StaticResource SubtleColor}" />
    <SolidColorBrush x:Key="DeviceRowBg" Color="{StaticResource DeviceRowColor}" />
    <SolidColorBrush x:Key="InputBg" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="GutterBg" Color="{StaticResource GutterColor}" />
    <SolidColorBrush x:Key="TileBg" Color="{StaticResource TileColor}" />
    <SolidColorBrush x:Key="TileHeaderBg" Color="{StaticResource TileHeaderColor}" />
    <SolidColorBrush x:Key="VideoBg" Color="{StaticResource VideoColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="BadgeBorder" Color="{StaticResource BadgeBorderColor}" />
    <SolidColorBrush x:Key="TileBorder" Color="{StaticResource TileBorderColor}" />
    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource TextStrongColor}" />
    <SolidColorBrush x:Key="TextFg" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="IconFg" Color="{StaticResource IconColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Offline" Color="{StaticResource OfflineColor}" />
    <SolidColorBrush x:Key="HoverBg" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBg" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="ListSelectedBg" Color="{StaticResource ListSelectedColor}" />
    <SolidColorBrush x:Key="SelectedBg" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="SelectedFg" Color="{StaticResource SelectedTextColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="Online" Color="{StaticResource OnlineColor}" />
    <SolidColorBrush x:Key="Recorded" Color="{StaticResource RecordedColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningText" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerIcon" Color="{StaticResource DangerIconColor}" />
    <SolidColorBrush x:Key="DangerText" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="SwitchOff" Color="{StaticResource SwitchOffColor}" />
    <SolidColorBrush x:Key="SwitchKnob" Color="{StaticResource SwitchKnobColor}" />
    <SolidColorBrush x:Key="WallText" Color="{StaticResource WallTextColor}" />
    <SolidColorBrush x:Key="WallLine" Color="{StaticResource WallLineColor}" />
    <SolidColorBrush x:Key="ScrimBg" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="FlashBg" Color="{StaticResource FlashColor}" />

    <!-- Recorder settings badges (soft backgrounds behind Online / WarningText text) -->
    <SolidColorBrush x:Key="OnlineSoftBg" Color="#DFF6DD" />
    <SolidColorBrush x:Key="WarningSoftBg" Color="#FFF4CE" />
    <!-- Danger band and filled danger button of Bakım › Fabrika ayarları (phase 3) -->
    <SolidColorBrush x:Key="DangerSoftBg" Color="#FDE7E9" />
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <!-- In-app update banner of the main window (accent-tinted, under the top bar) -->
    <SolidColorBrush x:Key="InfoSoftBg" Color="#E8F1FA" />
    <!-- Kayıt oynatma › Video indir: date range band and checked camera rows -->
    <SolidColorBrush x:Key="RangeBg" Color="#CCE4F7" />
    <!-- Tool bar over a playback tile (hover): on the always dark wall in both themes -->
    <SolidColorBrush x:Key="TileBarBg" Color="#D9202020" />
    <SolidColorBrush x:Key="TileBarFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileBarHoverBg" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TileBarActiveBg" Color="#594CC2FF" />
    <SolidColorBrush x:Key="TileBarRecord" Color="#FF6B5E" />
    <!-- Download pill in the top bar: finished (green) / finished with problems (amber) -->
    <SolidColorBrush x:Key="OkSoftBg" Color="#DFF6DD" />
    <SolidColorBrush x:Key="OkBorder" Color="#9FD89F" />
    <SolidColorBrush x:Key="OkText" Color="#0E5A0E" />
    <SolidColorBrush x:Key="WarningSoftBorder" Color="#F0D58A" />
    <!-- Events panel: unread rows (a shade lighter than the panel, BarBg) -->
    <SolidColorBrush x:Key="UnreadRowBg" Color="#FFFFFF" />
</ResourceDictionary>
