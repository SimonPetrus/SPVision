<UserControl x:Class="SPVision.Views.RecorderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SPVision.Controls">
    <!-- Settings › Cihaz ayarları. Opening the page or a tab only reads (ISAPI GET); the recorder is written only by
         "Cihaza uygula" after a confirmation, through IsapiClient.PutConfigAsync and its allowlist (risky operations:
         reboot, disk format, network address, users - their own RiskyConfirmDialog and IsapiClient.SendRiskyAsync). Tab contents are
         built in code (RecorderSettingsView.xaml.cs): cards with a header row (title + description | Geri al ·
         Cihaza uygula, 120×30) and rows (label + help | control, 240 px). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SPVision;component/Themes/RecorderControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <StreamGeometry x:Key="IconExternal">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,19 A1,1 0 0 1 17,20 L5,20 A1,1 0 0 1 4,19 L4,7 A1,1 0 0 1 5,6 L10,6</StreamGeometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="1040">
            <!-- Header: title + description | device selector · web UI, both 180×32 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Cihaz ayarları" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               Text="Buradaki değişiklikler “Cihaza uygula” ile, onayınızdan sonra doğrudan kayıt cihazına yazılır."
                               ToolTip="Buradaki değişiklikler “Cihaza uygula” ile, onayınızdan sonra doğrudan kayıt cihazına yazılır. Akış şifreleme ve Hik-Connect hiçbir zaman değiştirilmez." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="DeviceCombo" Width="180" Height="32" SelectionChanged="DeviceCombo_SelectionChanged"
                              FontSize="{StaticResource FontSizeList}" FontWeight="SemiBold"
                              AutomationProperties.Name="Kayıt cihazı seç" />
                    <Button x:Name="WebButton" Style="{StaticResource SettingsButton}" Width="180" Height="32" Margin="8,0,0,0"
                            Click="Web_Click" ToolTip="Cihazın kendi ayar sayfasını varsayılan tarayıcıda açar"
                            AutomationProperties.Name="Web arayüzünü aç">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Web arayüzünü aç" VerticalAlignment="Center" />
                            <c:GlyphIcon Data="{StaticResource IconExternal}" Size="13" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab strip: 9 equal tabs -->
            <Border Style="{StaticResource RecorderTabStrip}" Margin="0,16,0,0">
                <UniformGrid x:Name="TabBar" Rows="1" Columns="9" AutomationProperties.Name="Cihaz ayar bölümleri" />
            </Border>

            <!-- Content of the selected tab -->
            <StackPanel x:Name="TabContent" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
