<UserControl x:Class="SPVision.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SPVision.Controls"
             xmlns:v="clr-namespace:SPVision.Views">
    <DockPanel Background="{DynamicResource WindowBg}">
        <!-- ===== Sidebar, 260 px like the live one: calendar, then the camera check list ===== -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="260" Background="{DynamicResource BarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Month view, 10 px padding; days with recordings of the focused camera carry a dot. -->
                <Border DockPanel.Dock="Top" Padding="10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        AutomationProperties.Name="Tarih">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevMonthButton" Style="{StaticResource GhostIconButton}" Click="PrevMonth_Click"
                                    ToolTip="Önceki ay" AutomationProperties.Name="Önceki ay">
                                <c:GlyphIcon Data="{StaticResource IconChevronLeft}" Size="14" Foreground="{DynamicResource IconFg}" />
                            </Button>
                            <TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TextStrong}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="NextMonthButton" Grid.Column="2" Style="{StaticResource GhostIconButton}" Click="NextMonth_Click"
                                    ToolTip="Sonraki ay" AutomationProperties.Name="Sonraki ay">
                                <c:GlyphIcon Data="{StaticResource IconChevronRight}" Size="14" Foreground="{DynamicResource IconFg}" />
                            </Button>
                        </Grid>
                        <!-- -1 px cancels the 1 px day margin, so the outer cells line up with the month buttons. -->
                        <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="-1,0" />
                        <UniformGrid x:Name="DayGrid" Columns="7" Margin="-1,0" />
                    </StackPanel>
                </Border>

                <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="KAMERALAR" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="SelectionCount" Grid.Column="1" Style="{StaticResource CaptionText}" Margin="8,0,0,0"
                               Typography.NumeralAlignment="Tabular" ToolTip="Izgaradaki kamera sayısı / kare sayısı" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="0,0,0,6" AutomationProperties.Name="Oynatılacak kameralar">
                    <StackPanel x:Name="CameraList" PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="CameraList_PreviewMouseMove" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== "Video indir": 400 px column on the right, full height; the tiles shrink while it is open (a real layout
             column: nothing may be drawn over the video HWNDs). Opened from a tile's hover bar. ===== -->
        <v:DownloadPanel x:Name="DownloadPanel" DockPanel.Dock="Right" Visibility="Collapsed" />

        <DockPanel>
            <!-- ===== Info bar, 32 px: date + time · state + speed (or an amber notice) · timeline camera ===== -->
            <Border DockPanel.Dock="Top" Margin="12,12,12,0" Height="32" Padding="12,0" Background="{DynamicResource TileHeaderBg}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock x:Name="DateText" FontSize="{StaticResource FontSizeTile}" Foreground="{DynamicResource TextSecondary}"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimeText" Margin="10,0,0,0" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextStrong}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="16,0" MaxWidth="380" VerticalAlignment="Center">
                        <StackPanel x:Name="StatePanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="PlayStateText" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource TextFg}"
                                       VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="3"
                                    Padding="6,0" VerticalAlignment="Center" ToolTip="Oynatma hızı">
                                <TextBlock x:Name="SpeedBadge" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold"
                                           Foreground="{DynamicResource IconFg}" Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </StackPanel>
                        <Grid x:Name="MessagePanel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:GlyphIcon Data="{StaticResource IconInfo}" Size="13" Foreground="{DynamicResource WarningText}" />
                            <TextBlock x:Name="MessageText" Grid.Column="1" Margin="5,0,0,0" FontSize="{StaticResource FontSizeStatus}"
                                       Foreground="{DynamicResource WarningText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Zaman çizelgesi:" FontSize="{StaticResource FontSizeStatus}" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="FocusName" Grid.Column="1" Margin="6,0,0,0" FontSize="{StaticResource FontSizeStatus}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFg}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Timeline: [−] [timeline 50 px] [+], buttons as tall as the timeline ===== -->
            <Grid DockPanel.Dock="Bottom" Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ZoomOutButton" Style="{StaticResource TimelineZoomButton}" Click="ZoomOut_Click"
                        ToolTip="Uzaklaştır" AutomationProperties.Name="Uzaklaştır">
                    <c:GlyphIcon Data="{StaticResource IconMinus}" Size="13" StrokeThickness="2.5" />
                </Button>
                <c:TimelineBar x:Name="Timeline" Grid.Column="1" Margin="6,0" />
                <Button x:Name="ZoomInButton" Grid.Column="2" Style="{StaticResource TimelineZoomButton}" Click="ZoomIn_Click"
                        ToolTip="Yakınlaştır" AutomationProperties.Name="Yakınlaştır">
                    <c:GlyphIcon Data="{StaticResource IconPlus}" Size="13" StrokeThickness="2.5" />
                </Button>
            </Grid>

            <!-- ===== Control bar: 30 px controls, 8 px above and below, 4 px between the buttons of a group. The two
                 side columns are equal stars (left group 4 × 30 + 3 × 4 = 132 px, right group 98 px), so the centre
                 group sits exactly in the middle whatever the side groups hold. ===== -->
            <Grid DockPanel.Dock="Bottom" Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerAccentButton}" Click="PlayPause_Click"
                            ToolTip="Duraklat" AutomationProperties.Name="Duraklat">
                        <c:GlyphIcon x:Name="PlayPauseIcon" FillData="{StaticResource IconPause}" Size="14" />
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource PlayerAccentButton}" Margin="4,0,0,0" Click="Stop_Click"
                            IsEnabled="False" ToolTip="Durdur" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.AutomationId="PlaybackStop" AutomationProperties.Name="Durdur">
                        <c:GlyphIcon FillData="{StaticResource IconStop}" Size="14" />
                    </Button>
                    <Button x:Name="SnapshotButton" Style="{StaticResource PlayerButton}" Margin="4,0,0,0" Click="Snapshot_Click"
                            ToolTip="Anlık görüntü (seçili kare)" AutomationProperties.Name="Seçili kareden anlık görüntü">
                        <c:GlyphIcon Data="{StaticResource IconCamera}" Size="15" />
                    </Button>
                    <Button x:Name="ClipButton" Style="{StaticResource PlayerButton}" Margin="4,0,0,0" Click="Clip_Click"
                            ToolTip="Klip al (seçili kare, MP4)" AutomationProperties.Name="Seçili kareden klip al">
                        <c:GlyphIcon x:Name="ClipIcon" Data="{StaticResource IconScissors}" Size="15" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <Button x:Name="BackButton" Style="{StaticResource PlayerButton}" Click="Back_Click" ToolTip="30 saniye geri" AutomationProperties.Name="30 saniye geri">
                        <c:GlyphIcon Data="{StaticResource IconBack30}" Label="30" LabelX="12.5" Size="19" StrokeThickness="1.8" />
                    </Button>
                    <ToggleButton x:Name="TimeButton" Style="{StaticResource PlayerTimeButton}" Margin="6,0"
                                  ToolTip="Saate gitmek için tıklayın" AutomationProperties.Name="Oynatma saati, saate gitmek için tıklayın">
                        <StackPanel Orientation="Horizontal">
                            <c:GlyphIcon Data="{StaticResource IconClock}" Size="13" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="TimeButtonText" Margin="8,0,0,0" FontSize="{StaticResource FontSizeBase}" FontWeight="Bold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="ForwardButton" Style="{StaticResource PlayerButton}" Click="Forward_Click" ToolTip="30 saniye ileri" AutomationProperties.Name="30 saniye ileri">
                        <c:GlyphIcon Data="{StaticResource IconForward30}" Label="30" LabelX="11.5" Size="19" StrokeThickness="1.8" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" AutomationProperties.Name="Oynatma hızı">
                    <Button x:Name="SlowerButton" Style="{StaticResource PlayerButton}" Click="Slower_Click"
                            ToolTip="Yavaşlat" AutomationProperties.Name="Yavaşlat">
                        <c:GlyphIcon FillData="{StaticResource IconSlower}" Size="14" />
                    </Button>
                    <TextBlock x:Name="SpeedText" Width="30" Margin="4,0" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeTile}" FontWeight="Bold" Foreground="{DynamicResource TextStrong}"
                               Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="Oynatma hızı" />
                    <Button x:Name="FasterButton" Style="{StaticResource PlayerButton}" Click="Faster_Click"
                            ToolTip="Hızlandır" AutomationProperties.Name="Hızlandır">
                        <c:GlyphIcon FillData="{StaticResource IconFaster}" Size="14" />
                    </Button>
                </StackPanel>

                <!-- "Saate git": centred 8 px above the time button. Enter = Git, Esc closes. -->
                <Popup x:Name="GoToPopup">
                    <Border Style="{StaticResource PopupPanel}" Width="232" Padding="14" AutomationProperties.Name="Saate git">
                        <StackPanel>
                            <TextBlock Text="SAATE GİT" Style="{StaticResource CaptionText}" FontSize="{StaticResource FontSizeTile}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBox x:Name="HourBox" Style="{StaticResource TimeInput}" AutomationProperties.Name="Saat"
                                             PreviewTextInput="Digits_PreviewTextInput" KeyDown="TimeBox_KeyDown" GotKeyboardFocus="TimeBox_GotKeyboardFocus" />
                                    <TextBlock Text="saat" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                                <!-- Centred in the 44 px input height, like the digits beside it. -->
                                <Border Height="44" Margin="8,0" VerticalAlignment="Top">
                                    <TextBlock Text=":" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBox x:Name="MinuteBox" Style="{StaticResource TimeInput}" AutomationProperties.Name="Dakika"
                                             PreviewTextInput="Digits_PreviewTextInput" KeyDown="TimeBox_KeyDown" GotKeyboardFocus="TimeBox_GotKeyboardFocus" />
                                    <TextBlock Text="dakika" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="GoToCancelButton" Content="İptal" Style="{StaticResource PopupButton}" Click="GoToCancel_Click" />
                                <Button x:Name="GoToButton" Content="Git" Grid.Column="2" Style="{StaticResource PopupAccentButton}" Click="GoTo_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Hover tool bar of a tile: a Popup (its own window, the only thing drawn over the video HWND), placed by
                     the view over the bottom edge of the hovered tile's video area; never takes focus. -->
                <Popup x:Name="TileBarPopup" AllowsTransparency="True" PopupAnimation="None" StaysOpen="True" Placement="Relative"
                       Focusable="False">
                    <c:TileToolBar x:Name="TileBar" />
                </Popup>
            </Grid>

            <!-- ===== Tile grid on the (always dark) wall; 2 px here + 2 px tile margin = 4 px gutter and gaps ===== -->
            <Border Margin="12,6,12,0" Background="{DynamicResource GutterBg}" CornerRadius="3">
                <Grid x:Name="TileGrid" Margin="2" />
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
