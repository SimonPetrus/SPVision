<UserControl x:Class="SPVision.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- First run (no saved device): covers the whole window. One centred 880 px card, 32 px inside: logo 56, title,
         subtitle, then the shared AddDevicePanel (online devices + compact form centred, two equal 160×30 buttons).
         Scrolls when the window is shorter than the card. -->
    <ScrollViewer Background="{DynamicResource WindowBg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Width="880" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Shadow on its own layer, so the card's text is not rendered through the effect (stays crisp). -->
        <Border Background="{DynamicResource CardBg}" CornerRadius="12" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.08" Color="Black" />
            </Border.Effect>
        </Border>
        <Border Padding="32" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12"
                SnapsToDevicePixels="True" AutomationProperties.AutomationId="FirstRunCard" AutomationProperties.Name="İlk kurulum">
            <StackPanel>
                <Image Source="{StaticResource AppLogo}" Width="56" Height="56" Stretch="Fill" HorizontalAlignment="Center"
                       UseLayoutRounding="True" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextStrong}"><Run Text="SP" Foreground="{DynamicResource Accent}" /><Run Text="Vision'a hoş geldiniz" /></TextBlock>
                <TextBlock Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TextSecondary}"
                           Text="Başlamak için kayıt cihazınızı ekleyin. Yerel ağınızdaki cihazlar aranıyor; listeden seçin ya da bilgileri elle yazın." />
                <ContentControl x:Name="PanelHost" Margin="0,16,0,0" Focusable="False" />
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
