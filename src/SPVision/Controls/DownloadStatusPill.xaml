<UserControl x:Class="SPVision.Controls.DownloadStatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SPVision.Controls"
             Height="36" Visibility="Collapsed" Focusable="False"
             AutomationProperties.AutomationId="DownloadProgressPill" AutomationProperties.Name="İndirme ilerlemesi"
             AutomationProperties.LiveSetting="Polite">
    <UserControl.Resources>
        <!-- 26 px pill button (radius 13), 1 px border, transparent; hover tint. Width per use: İptal 64, Klasörü aç 96. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeStatus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Light shadow on a separate layer (an effect on the pill itself would render its text through a bitmap). -->
        <Border x:Name="Shadow" CornerRadius="18" Background="{DynamicResource CardBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="Black" />
            </Border.Effect>
        </Border>
        <!-- 36 px, radius 18, 1 px border; 12 px inside on the left, 6 px on the right (the 26 px button sits 5 px from
             the top, bottom and right edge). Columns: 16 icon · text · button, 10 px apart. -->
        <Border x:Name="PillBorder" CornerRadius="18" BorderThickness="1" Padding="12,0,6,0" SnapsToDevicePixels="True"
                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}">
            <Grid>
                <!-- ===== Running: icon · name, "kamera i / n", NN%, "kalan m:ss" over a 4 px bar · İptal ===== -->
                <Grid x:Name="ProgressView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressIconColumn" Width="16" />
                        <ColumnDefinition x:Name="ProgressIconGap" Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <local:GlyphIcon x:Name="ProgressIcon" Data="{StaticResource IconDownload}" Size="16" StrokeThickness="2.2" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Accent}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid x:Name="ProgressLine" TextElement.FontSize="{StaticResource FontSizeStatus}"
                              Typography.NumeralAlignment="Tabular" SizeChanged="ProgressLine_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CameraText" FontWeight="SemiBold" Foreground="{DynamicResource TextFg}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StepText" Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="PercentText" Grid.Column="3" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFg}" />
                            <TextBlock x:Name="RemainingText" Grid.Column="4" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                        <!-- 4 px bar, radius 2: two star columns share the width by the percentage. -->
                        <Grid x:Name="Bar" Height="4" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BarDone" Width="0*" />
                                <ColumnDefinition x:Name="BarLeft" Width="100*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource InputBorder}" />
                            <Border CornerRadius="2" Background="{DynamicResource Accent}" />
                        </Grid>
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Column="4" Width="64" Content="İptal" Style="{StaticResource PillButton}"
                            VerticalAlignment="Center" Click="Cancel_Click" ToolTip="İndirmeyi durdur (yarım dosya silinir)"
                            AutomationProperties.AutomationId="DownloadProgressCancel" AutomationProperties.Name="İndirmeyi iptal et" />
                </Grid>

                <!-- ===== Finished: check · "İndirme bitti · N dosya kaydedildi" · Klasörü aç ===== -->
                <Grid x:Name="ResultView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResultIconColumn" Width="16" />
                        <ColumnDefinition x:Name="ResultIconGap" Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ResultButtonGap" Width="10" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <local:GlyphIcon x:Name="ResultIcon" Data="{StaticResource IconCheck}" Size="16" StrokeThickness="2.6"
                                     VerticalAlignment="Center" Foreground="{DynamicResource Online}" />
                    <TextBlock x:Name="ResultText" Grid.Column="2" VerticalAlignment="Center" FontSize="{StaticResource FontSizeTile}"
                               FontWeight="SemiBold" Foreground="{DynamicResource OkText}" TextTrimming="CharacterEllipsis"
                               Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="DownloadResultText" />
                    <Button x:Name="OpenFolderButton" Grid.Column="4" Width="96" Content="Klasörü aç" Style="{StaticResource PillButton}"
                            VerticalAlignment="Center" FontWeight="SemiBold" BorderBrush="{DynamicResource OkBorder}"
                            Foreground="{DynamicResource OkText}" Click="OpenFolder_Click"
                            AutomationProperties.AutomationId="DownloadOpenFolder" AutomationProperties.Name="Klasörü aç" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
