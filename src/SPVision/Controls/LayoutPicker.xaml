<UserControl x:Class="SPVision.Controls.LayoutPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SPVision.Controls"
             VerticalAlignment="Center">
    <Grid>
        <!-- 36 px, min 96: mini diagram (22×16) · tile count · chevron. Selected while the popup is open. -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource LayoutPickerButton}" ToolTip="Izgara düzeni"
                      AutomationProperties.Name="Izgara düzeni seç">
            <StackPanel Orientation="Horizontal">
                <local:LayoutDiagram x:Name="CurrentDiagram" Width="22" Height="16" Gap="1" Opacity="0.85" />
                <TextBlock x:Name="CurrentCount" MinWidth="20" Margin="8,0" TextAlignment="Center" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
                <local:GlyphIcon Data="{StaticResource IconChevronDown}" Size="12" StrokeThickness="2.5"
                                 Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </ToggleButton>

        <!-- 404 px wide, right edge under the button's right edge, 4 px below it. Items: 6 columns,
             62 px high, 8 px gaps (4 px margin each) and 14 px from every edge of the panel. -->
        <Popup x:Name="Panel">
            <Border Style="{StaticResource PopupPanel}" Width="404" AutomationProperties.Name="Izgara düzenleri">
                <StackPanel>
                    <TextBlock Text="STANDART" Style="{StaticResource CaptionText}" Margin="14,14,14,0" />
                    <UniformGrid x:Name="StandardItems" Columns="6" Margin="10,6,10,10" />
                    <Border x:Name="BigSection" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="BÜYÜK KARELİ" Style="{StaticResource CaptionText}" Margin="14,14,14,0" />
                            <UniformGrid x:Name="BigItems" Columns="6" Margin="10,6,10,10" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
