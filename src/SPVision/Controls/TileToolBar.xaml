<UserControl x:Class="SPVision.Controls.TileToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SPVision.Controls"
             Focusable="False" AutomationProperties.AutomationId="TileToolBar" AutomationProperties.Name="Kare araçları">
    <UserControl.Resources>
        <!-- 28×24 icon button on the dark bar: white glyph, light hover, accent tint while its tool is on. Never takes focus
             (the bar is a Popup over the video; the main window keeps the keyboard). -->
        <Style x:Key="TileBarButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TileBarFg}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileBarHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 32 px bar along the bottom edge of the tile's video area, full width; buttons right-aligned, 4 px apart, 8 px from
         the edge, vertically centred (4 px above and below). -->
    <Border x:Name="Bar" Height="32" Background="{DynamicResource TileBarBg}" Padding="8,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="SnapshotButton" Style="{StaticResource TileBarButton}" Click="Snapshot_Click"
                    ToolTip="Resim al" AutomationProperties.AutomationId="TileBarSnapshot" AutomationProperties.Name="Resim al">
                <local:GlyphIcon Data="{StaticResource IconCamera}" Size="15" />
            </Button>
            <Button x:Name="ClipButton" Style="{StaticResource TileBarButton}" Margin="4,0,0,0" Click="Clip_Click"
                    ToolTip="Klip kaydet" AutomationProperties.AutomationId="TileBarClip" AutomationProperties.Name="Klip kaydet">
                <local:GlyphIcon x:Name="ClipIcon" Data="{StaticResource IconRecord}" FillData="{StaticResource IconRecordDot}" Size="15" />
            </Button>
            <Button x:Name="ZoomButton" Style="{StaticResource TileBarButton}" Margin="4,0,0,0" Click="Zoom_Click"
                    ToolTip="Yakınlaştır" AutomationProperties.AutomationId="TileBarZoom" AutomationProperties.Name="Yakınlaştır">
                <local:GlyphIcon Data="{StaticResource IconZoomIn}" Size="15" />
            </Button>
            <Button x:Name="DownloadButton" Style="{StaticResource TileBarButton}" Margin="4,0,0,0" Click="Download_Click"
                    ToolTip="İndir" AutomationProperties.AutomationId="TileBarDownload" AutomationProperties.Name="İndir">
                <local:GlyphIcon Data="{StaticResource IconDownload}" Size="15" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
