                    mc:Ignorable="po">
    <!-- SPVision logo (variant 2D) as vector art, for the top bar wordmark (shown at 24×24).
         Same drawing as the 24 px frame of Assets/SPVision.ico: 24-unit space, pixel-aligned (1 px ring on the
         pixel centre, 2 px viewfinder corners on whole pixels, "SP" baseline on y = 15). The "SP" is Segoe UI Black
         converted to outlines, so it does not depend on installed fonts. Fixed colours, as in the .ico: the dark tile
         with its grey ring reads on both the light and the dark top bar. Master vector: Assets/SPVision.svg. -->
    <DrawingImage x:Key="AppLogo" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fixed 24×24 bounds so the image never shifts or rescales. -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                <!-- Tile: #111111, 1 px #3A3A3A ring, radius 5.25 -->
                <GeometryDrawing Brush="#111111">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3A3A3A" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0.5,0.5,23,23" RadiusX="5.25" RadiusY="5.25" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Viewfinder corners: 2 px, round caps and joins -->
                <GeometryDrawing Geometry="M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#4CC2FF" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- "S" (white) -->
                <GeometryDrawing Brush="#FFFFFF"
                                 Geometry="F1 M9.558,8.593 C9.777,8.593 9.979,8.602 10.164,8.619 10.349,8.637 10.516,8.659 10.667,8.685 10.818,8.711 11.03,8.761 11.302,8.834 L11.302,10.438 C10.772,10.148 10.25,10.003 9.738,10.003 9.527,10.003 9.357,10.043 9.228,10.122 9.099,10.201 9.035,10.31 9.035,10.447 9.035,10.579 9.087,10.688 9.191,10.775 9.295,10.861 9.512,10.973 9.843,11.111 10.497,11.375 10.959,11.663 11.23,11.977 11.501,12.29 11.636,12.662 11.636,13.093 11.636,13.512 11.524,13.876 11.3,14.187 11.076,14.498 10.762,14.729 10.357,14.881 9.953,15.034 9.467,15.11 8.898,15.11 8.239,15.11 7.636,14.999 7.088,14.776 L7.088,13.049 C7.352,13.242 7.643,13.398 7.962,13.517 8.282,13.635 8.579,13.695 8.854,13.695 9.062,13.695 9.224,13.657 9.338,13.583 9.452,13.508 9.509,13.399 9.509,13.255 9.509,13.153 9.481,13.063 9.424,12.985 9.366,12.907 9.28,12.835 9.164,12.768 9.049,12.7 8.834,12.608 8.521,12.491 7.507,12.101 7,11.471 7,10.601 7,9.992 7.231,9.505 7.694,9.14 8.157,8.775 8.778,8.593 9.558,8.593 Z" />
                <!-- "P" (accent blue) -->
                <GeometryDrawing Brush="#4CC2FF"
