<Window x:Class="SPVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SPVision.Views"
        xmlns:c="clr-namespace:SPVision.Controls"
        Title="SPVision" Icon="Assets/SPVision.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextFg}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SPVision;component/Themes/EventControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Root: the app (AppShell) and, on first run (no saved device), the welcome screen over it (FirstRunView, added in code;
         AppShell is collapsed meanwhile so no video window can draw over it). -->
    <Grid x:Name="RootGrid">
    <DockPanel x:Name="AppShell">
        <!-- ===== Top bar, 52 px: wordmark · tabs · (live) layout picker, quality, actions / (playback) layout picker · settings (gear = third view) ===== -->
        <Border x:Name="Header" DockPanel.Dock="Top" Height="52" Background="{DynamicResource BarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid x:Name="HeaderLayer">
                <Grid x:Name="HeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo 24×24 (Assets/Logo.xaml); layout rounding keeps it on whole pixels so it stays crisp. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" UseLayoutRounding="True"
                                AutomationProperties.Name="SPVision">
                        <Image Source="{StaticResource AppLogo}" Width="24" Height="24" VerticalAlignment="Center" Stretch="Fill" />
                        <TextBlock FontSize="{StaticResource FontSizeBrand}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextStrong}"><Run Text="SP" Foreground="{DynamicResource Accent}" /><Run Text="Vision" /></TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="TabsPanel" Grid.Column="1" Orientation="Horizontal">
                        <c:ClickToggleButton x:Name="LiveTab" Content="Canlı İzleme" Style="{StaticResource TabButton}" IsChecked="True" Click="LiveTab_Click" />
                        <c:ClickToggleButton x:Name="PlaybackTab" Content="Kayıt Oynatma" Style="{StaticResource TabButton}" Click="PlaybackTab_Click" />
                    </StackPanel>

                    <!-- Every control here is 36 px tall: layout picker, segmented group (1 + 2 + 30 + 2 + 1) and icon buttons. -->
                    <StackPanel x:Name="ToolsPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="LiveTools" Orientation="Horizontal">
                            <c:LayoutPicker x:Name="LivePicker" />
                            <Border Style="{StaticResource SegmentGroup}" Margin="12,0,0,0" AutomationProperties.Name="Görüntü kalitesi">
                                <StackPanel Orientation="Horizontal">
                                    <c:ClickToggleButton x:Name="QualityAuto" Content="Oto" Style="{StaticResource SegmentButton}" Click="QualityAuto_Click"
                                                  ToolTip="Küçük karelerde SD, büyük karelerde HD (önerilen, işlemciyi yormaz)" AutomationProperties.Name="Otomatik kalite" />
                                    <c:ClickToggleButton x:Name="QualityHd" Content="HD" Style="{StaticResource SegmentButton}" Click="QualityHd_Click" Margin="2,0,0,0"
                                                  ToolTip="Tüm kareler ana akış (yüksek çözünürlük)" AutomationProperties.Name="HD kalite" />
                                    <c:ClickToggleButton x:Name="QualitySd" Content="SD" Style="{StaticResource SegmentButton}" Click="QualitySd_Click" Margin="2,0,0,0"
                                                  ToolTip="Tüm kareler alt akış (düşük çözünürlük)" AutomationProperties.Name="SD kalite" />
                                </StackPanel>
                            </Border>
                            <c:ClickToggleButton x:Name="MotionToggle" Style="{StaticResource IconToggleButton}" Margin="12,0,0,0" Click="MotionToggle_Click"
                                          ToolTip="Hareket kutularını göster/gizle" AutomationProperties.Name="Hareket kutularını göster/gizle">
                                <c:GlyphIcon Data="{StaticResource IconMotion}" FillData="{StaticResource IconMotionDot}" />
                            </c:ClickToggleButton>
                            <Button x:Name="SnapshotButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Snapshot_Click"
                                    ToolTip="Anlık görüntü (seçili kare)" AutomationProperties.Name="Seçili kameradan anlık görüntü al">
                                <c:GlyphIcon Data="{StaticResource IconCamera}" />
                            </Button>
                            <Button x:Name="RecordButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Record_Click"
                                    ToolTip="Kayıt (seçili kare, MP4)" AutomationProperties.Name="Seçili kamerayı kaydet">
                                <c:GlyphIcon x:Name="RecordIcon" Data="{StaticResource IconRecord}" FillData="{StaticResource IconRecordDot}"
                                             Foreground="{DynamicResource DangerIcon}" />
                            </Button>
                            <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="FullScreen_Click"
                                    ToolTip="Tam ekran (F11)" AutomationProperties.Name="Tam ekran (F11)">
                                <c:GlyphIcon Data="{StaticResource IconFullScreen}" />
                            </Button>
                        </StackPanel>
                        <!-- Playback: layout picker limited to 16 tiles (synchronous playback). -->
                        <StackPanel x:Name="PlaybackTools" Orientation="Horizontal" Visibility="Collapsed">
                            <c:LayoutPicker x:Name="PlaybackPicker" />
                        </StackPanel>
                        <!-- Events bell (every view): toggles the 320 px OLAYLAR panel; red unread count on its corner, 6 px out
                             (2 px ring of the bar colour). 12 px after the page tools, then the one separator before the gear. -->
                        <Grid x:Name="EventsBell" Margin="12,0,0,0" VerticalAlignment="Center">
                            <c:ClickToggleButton x:Name="EventsButton" Style="{StaticResource IconToggleButton}" Click="EventsButton_Click"
                                                 ToolTip="Olaylar" AutomationProperties.Name="Olaylar" AutomationProperties.AutomationId="EventsButton">
                                <c:GlyphIcon Data="{StaticResource IconBell}" />
                            </c:ClickToggleButton>
                            <Border x:Name="EventsBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" MinWidth="18" Height="18"
                                    CornerRadius="9" Padding="3,0" BorderThickness="2" Background="{DynamicResource DangerIcon}"
                                    BorderBrush="{DynamicResource BarBg}" IsHitTestVisible="False" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="EventsBadge">
                                <TextBlock x:Name="EventsBadgeText" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnDanger}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Rectangle Width="1" Height="24" Margin="12,0" Fill="{DynamicResource Border}" VerticalAlignment="Center" />
                        <c:ClickToggleButton x:Name="SettingsButton" Style="{StaticResource IconToggleButton}" Click="Settings_Click"
                                      ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                            <c:GlyphIcon Data="{StaticResource IconSettings}" />
                        </c:ClickToggleButton>
                    </StackPanel>
                </Grid>
                <!-- Download pill ("Video indir" running / finished): exactly centred in the window (the bar's 12 px insets
                     are equal), 440 × 36, 8 px from the top; narrower when the tabs or the tools would be touched (MainWindow). -->
                <c:DownloadStatusPill x:Name="DownloadPillView" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===== Update banner under the top bar: an optional update (a mandatory one gets a blocking dialog). 41 px = 40 px
             content + 1 px bottom border, so the 30 px buttons have exactly 5 px above and below. Same 12 px inset as the top
             bar; three 120×30 slots with 8 px gaps on the right:
             [Neler yeni] [Sonra | progress 120] [Güncelle | İptal]. Hidden in full screen. ===== -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Height="41" Background="{DynamicResource InfoSoftBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,0" Visibility="Collapsed"
                AutomationProperties.AutomationId="UpdateBanner" AutomationProperties.Name="Güncelleme">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:GlyphIcon Data="{StaticResource IconInfo}" Size="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                <TextBlock x:Name="UpdateBannerText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFg}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="UpdateBannerText" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNotesButton" Content="Neler yeni" Style="{StaticResource SettingsButton}" Click="UpdateNotes_Click"
                            ToolTip="Bu sürümdeki değişiklikleri göster" AutomationProperties.Name="Neler yeni" />
                    <Button x:Name="UpdateLaterButton" Content="Sonra" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"
                            Click="UpdateLater_Click" ToolTip="SPVision yeniden açılana kadar bu sürümü gösterme"
                            AutomationProperties.Name="Sonra" />
                    <Grid x:Name="UpdateBannerProgress" Width="120" Height="6" Margin="8,0,0,0" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateBannerProgress" AutomationProperties.Name="İndirme ilerlemesi">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" />
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource InputBorder}" />
                        <Border CornerRadius="3" Background="{DynamicResource Accent}" />
                    </Grid>
                    <Button x:Name="UpdateNowButton" Content="Güncelle" Style="{StaticResource SettingsAccentButton}" Margin="8,0,0,0"
                            Click="UpdateNow_Click" ToolTip="İndir, doğrula ve kur (yönetici izni istenir; SPVision yeniden açılır)"
                            AutomationProperties.Name="Güncelle" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status bar, 28 px. Three columns (* / Auto / *): the live view's page control sits exactly in the middle of
             the window whatever the status texts on the left and right are (they trim instead of pushing it). ===== -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource BarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,0"
                TextElement.FontSize="{StaticResource FontSizeStatus}" TextElement.Foreground="{DynamicResource TextSecondary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Items are centred vertically: the disk warning button is 23 px tall, the texts keep one baseline. -->
                <DockPanel VerticalAlignment="Center" ClipToBounds="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource Offline}" Margin="0,0,6,0" />
                        <TextBlock x:Name="ConnectionText" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <TextBlock x:Name="GroupText" DockPanel.Dock="Left" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                               AutomationProperties.AutomationId="GroupStatus" />
                    <TextBlock x:Name="OnScreenText" DockPanel.Dock="Left" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel x:Name="ReconnectPanel" DockPanel.Dock="Left" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Warning}" Margin="0,0,6,0" />
                        <TextBlock x:Name="ReconnectText" Foreground="{DynamicResource WarningText}" />
                    </StackPanel>
                    <!-- Disk warning (DiskMonitor), in every view: a recorder without disks or with a disk that is not healthy.
                         12 px margin + 6 px button padding = the same 18 px gap as the other items. Click: Ayarlar ›
                         Cihaz ayarları › Sistem (Diskler) of that recorder. -->
                    <Button x:Name="DiskWarningButton" DockPanel.Dock="Left" Style="{StaticResource StatusTextButton}" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="DiskWarning_Click" AutomationProperties.AutomationId="DiskWarning"
                            AutomationProperties.Name="Disk sorunu — kayıt yapılmıyor olabilir">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Danger}" Margin="0,0,6,0" />
                            <TextBlock x:Name="DiskWarningText" Foreground="{DynamicResource DangerText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VideoPathText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- Live view only, from 2 pages on: ‹ Sayfa 1 / 3 ›. Two equal 23×23 buttons around a fixed 88 px text
                     (fits "Sayfa 10 / 10"), so the arrows never move when the numbers change. -->
                <StackPanel x:Name="PagePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"
                            Visibility="Collapsed" AutomationProperties.Name="Sayfa">
                    <Button x:Name="PreviousPageButton" Style="{StaticResource StatusIconButton}" Click="PreviousPage_Click"
                            ToolTip="Önceki sayfa (PageUp)" AutomationProperties.Name="Önceki sayfa">
                        <c:GlyphIcon Data="{StaticResource IconChevronLeft}" Size="15" />
                    </Button>
                    <TextBlock x:Name="PageText" Width="88" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFg}" />
                    <Button x:Name="NextPageButton" Style="{StaticResource StatusIconButton}" Click="NextPage_Click"
                            ToolTip="Sonraki sayfa (PageDown)" AutomationProperties.Name="Sonraki sayfa">
                        <c:GlyphIcon Data="{StaticResource IconChevronRight}" Size="15" />
                    </Button>
                </StackPanel>
                <!-- Clock and CPU always show; a long message trims in the space left of them. -->
                <DockPanel Grid.Column="2" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Margin="18,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="CpuText" DockPanel.Dock="Right" Margin="18,0,0,0" Foreground="{DynamicResource TextSecondary}"
                               ToolTip="Bu uygulamanın işlemci kullanımı (tüm çekirdeklerin yüzdesi)" />
                    <TextBlock x:Name="MessageText" MaxWidth="460" Margin="18,0,0,0" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFg}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== Sidebar (live view), 260 px, 10 px padding on every side. Playback has its own, equally wide. ===== -->
        <Border x:Name="SidePanel" DockPanel.Dock="Left" Width="260" Background="{DynamicResource BarBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10">
                    <TextBlock Text="KAMERALAR" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Kamera ara" Height="32"
                             AutomationProperties.Name="Kamera ara" ToolTip="Kamera adına göre süz"
                             TextChanged="SearchBox_TextChanged" />
                </StackPanel>
                <!-- GRUPLAR (MainWindow.Groups.cs, Core CameraGroups): 36 px header (caption · 104×24 "Grup kaydet", 10 px
                     insets like the search above), then one 32 px row per group with 2 px gaps, 6 px from the sidebar edges
                     and 8 px above the device row. First row "Tüm kameralar" (built in, no ⋯ menu). Many groups scroll. -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Height="36" Margin="10,0">
                            <TextBlock Text="GRUPLAR" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <Button x:Name="SaveGroupButton" Style="{StaticResource GroupSaveButton}" HorizontalAlignment="Right"
                                    Click="SaveGroup_Click" ToolTip="Ekrandaki ızgarayı ve kameraları grup olarak kaydet"
                                    AutomationProperties.Name="Grup kaydet" AutomationProperties.AutomationId="GroupSave">
                                <StackPanel Orientation="Horizontal">
                                    <c:GlyphIcon Data="{StaticResource IconPlus}" Size="11" StrokeThickness="2.5" Margin="0,0,4,0" />
                                    <TextBlock Text="Grup kaydet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="244" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="GroupList" Margin="6,0,6,8" AutomationProperties.Name="Kamera grupları" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              ToolTip="Kamerayı bir kareye sürükleyin ya da çift tıklayın. Cihaz satırına çift tıklamak tüm kameralarını açar."
                              ToolTipService.InitialShowDelay="1200"
                              PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="List_PreviewMouseMove">
                    <StackPanel x:Name="DeviceList" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Events panel (bell), 320 px right of the view; hidden in full screen. ===== -->
        <v:EventPanel x:Name="EventsPanel" DockPanel.Dock="Right" Visibility="Collapsed" />

        <Grid>
            <v:LiveView x:Name="Live" />
            <v:PlaybackView x:Name="Playback" Visibility="Collapsed" />
            <v:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
    </Grid>
</Window>
