<UserControl x:Class="SP2026Lite.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:c="clr-namespace:SP2026Lite.Controls">
    <DockPanel Background="{StaticResource WindowBg}">
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Kamera:" VerticalAlignment="Center" Foreground="{StaticResource MutedFg}" Margin="2,0,6,0" />
                    <ComboBox x:Name="CameraBox" Width="220" DisplayMemberPath="Title" VerticalContentAlignment="Center" />
                    <TextBlock Text="Tarih:" VerticalAlignment="Center" Foreground="{StaticResource MutedFg}" Margin="12,0,6,0" />
                    <DatePicker x:Name="DayPicker" Width="130" VerticalContentAlignment="Center" />
                    <Button Content="🔍 Kayıtları ara" Style="{StaticResource AccentButton}" Margin="8,2,2,2" Click="Search_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PlayPauseButton" Content="⏸" Width="38" Click="PlayPause_Click" ToolTip="Oynat / duraklat" />
                    <Button Content="⏹" Width="38" Click="Stop_Click" ToolTip="Durdur" />
                    <Button Content="⏪ 30 sn" Click="Back_Click" />
                    <Button Content="30 sn ⏩" Click="Forward_Click" />
                    <Button Content="📷" Width="38" Click="Snapshot_Click" ToolTip="Anlık görüntü" />
                    <Button x:Name="ClipButton" Content="⏺ Klip kaydet" Click="Clip_Click" ToolTip="Oynatılan görüntüyü MP4 olarak kaydet" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,3" Foreground="{StaticResource MutedFg}" />
                <c:TimelineBar x:Name="Timeline" Margin="0,2,0,0" />
            </DockPanel>
        </Border>

        <Grid>
            <fl:FlyleafHost x:Name="Host" KeyBindings="None" MouseBindings="None"
                        ToggleFullScreenOnDoubleClick="None" PanMoveOnCtrl="None" PanZoomOnCtrlWheel="Surface"
                        PanRotateOnShiftWheel="None" AttachedDragMove="None" DetachedDragMove="None"
                        AttachedResize="None" DetachedResize="None" OpenOnDrop="None" SwapOnDrop="None"
                        SwapDragEnterOnShift="None" VideoBackground="Black">
            <Grid Background="#01000000">
                <TextBlock x:Name="OverlayText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="#8B92A0" TextWrapping="Wrap" Margin="16"
                           Text="Kamera ve tarih seçip &quot;Kayıtları ara&quot;ya basın" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#99000000" Padding="8,3" CornerRadius="0,0,4,0">
                    <TextBlock x:Name="ClockText" FontSize="14" FontFamily="Consolas" />
                </Border>
            </Grid>
            </fl:FlyleafHost>
            <!-- SDK path: PlayCtrl draws encrypted recordings here; hosts swap visibility with it. -->
            <c:HikVideoHost x:Name="HikHost" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
