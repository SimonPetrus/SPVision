<Window x:Class="SP2026Lite.Views.DeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cihaz" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBg}" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Label Content="Cihaz adı" />
        <TextBox x:Name="NameBox" />

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="IP adresi" />
                <TextBox x:Name="HostBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="HTTP port" />
                <TextBox x:Name="HttpPortBox" Text="80" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="RTSP port" />
                <TextBox x:Name="RtspPortBox" Text="554" />
            </StackPanel>
        </Grid>
        <CheckBox x:Name="HttpsBox" Content="HTTPS kullan" Margin="0,6,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Kullanıcı adı" />
                <TextBox x:Name="UserBox" Text="admin" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Şifre" />
                <PasswordBox x:Name="PasswordBox" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Akış anahtarı (doğrulama kodu)" />
                <PasswordBox x:Name="StreamKeyBox" />
            </StackPanel>
            <Button x:Name="FetchKeyButton" Grid.Column="2" Content="Cihazdan oku" Margin="0,0,0,1" VerticalAlignment="Bottom"
                    ToolTip="Anahtarı cihazdan okur (ISAPI/System/Network/EZVIZ)" Click="FetchKey_Click" />
        </Grid>

        <TextBlock Foreground="{StaticResource MutedFg}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                   Text="Şifre ve akış anahtarı Windows hesabınıza bağlı olarak şifreli saklanır. Akış anahtarı, kayıt cihazında akış şifreleme açıkken görüntüyü açmak için gereklidir (Hik-Connect doğrulama kodu)." />

        <Button Content="Bağlan ve kameraları getir" Margin="0,14,0,0" Click="Test_Click" />
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedFg}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" IsCancel="True" Width="90" />
            <Button Content="Kaydet" IsDefault="True" Width="90" Style="{StaticResource AccentButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
