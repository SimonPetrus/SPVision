<UserControl x:Class="SP2026Lite.Controls.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             xmlns:local="clr-namespace:SP2026Lite.Controls">
    <Grid>
        <Border x:Name="Frame" BorderThickness="2" BorderBrush="#2C3039" Background="Black" Margin="1">
            <Grid>
                <!-- SDK path: plain child HWND PlayCtrl draws into (encrypted streams) -->
                <local:HikVideoHost x:Name="HikHost" Visibility="Collapsed" />
                <!-- FFmpeg path (unencrypted streams) -->
                <fl:FlyleafHost x:Name="Host"
                                KeyBindings="None" MouseBindings="None"
                                ToggleFullScreenOnDoubleClick="None"
                                PanMoveOnCtrl="None" PanZoomOnCtrlWheel="None" PanRotateOnShiftWheel="None"
                                AttachedDragMove="None" DetachedDragMove="None" AttachedResize="None" DetachedResize="None"
                                OpenOnDrop="None" SwapOnDrop="None" SwapDragEnterOnShift="None"
                                BringToFrontOnClick="False" VideoBackground="Black" />
            </Grid>
        </Border>

        <!-- Overlay in its own popup window so it also covers the SDK's video HWND (airspace). -->
        <Popup x:Name="OverlayPopup" AllowsTransparency="True" StaysOpen="True" IsOpen="False"
               Placement="Relative" PlacementTarget="{Binding ElementName=Frame}">
            <Grid x:Name="Overlay" Background="#01000000" AllowDrop="True"
                  Width="{Binding ActualWidth, ElementName=Frame}"
                  Height="{Binding ActualHeight, ElementName=Frame}"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                  DragOver="Overlay_DragOver" Drop="Overlay_Drop">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                        <MenuItem x:Name="MenuMain" Header="HD — ana akış" Click="MenuMain_Click" />
                        <MenuItem x:Name="MenuSub" Header="SD — alt akış" Click="MenuSub_Click" />
                        <MenuItem x:Name="MenuAuto" Header="Otomatik (kare boyutuna göre)" Click="MenuAuto_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuSnapshot" Header="Anlık görüntü al" Click="MenuSnapshot_Click" />
                        <MenuItem x:Name="MenuRecord" Header="Kaydı başlat" Click="MenuRecord_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuReconnect" Header="Yeniden bağlan" Click="MenuReconnect_Click" />
                        <MenuItem x:Name="MenuClose" Header="Kareyi kapat" Click="MenuClose_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#99000000" CornerRadius="0,0,4,0" Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CameraName" FontSize="12" />
                        <TextBlock x:Name="QualityBadge" FontSize="10" Foreground="#8B92A0" Margin="6,1,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="RecBadge" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#E5484D"
                        CornerRadius="0,0,0,4" Padding="6,2" Visibility="Collapsed">
                    <TextBlock Text="● KAYIT" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="12" Foreground="#8B92A0" />
            </Grid>
        </Popup>
    </Grid>
</UserControl>
