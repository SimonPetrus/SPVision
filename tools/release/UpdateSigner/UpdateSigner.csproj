<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release tool: writes and signs manifest.json, creates the signing key pair. It compiles the app's own update code
       (src/SPVision.Core/Updates) so the manifest format, the signature format and the public key in UpdateTrust.cs are
       exactly what the app checks. Plain net10.0: also runs on the Linux runner of the CI path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SPVision.UpdateSigner</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\src\SPVision.Core\Updates\*.cs" Link="Updates\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
